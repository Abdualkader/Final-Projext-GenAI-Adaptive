rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Vocabulary media (images and audio): public read for child learning, authenticated write
    match /vocabulary/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User-uploaded assets (drawings, custom recordings) restricted to the authenticated parent/educator
    match /user_uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // System health check file for developer connectivity verification
    match /_system_health/{fileName} {
      allow read, write: if true;
    }
  }
}
